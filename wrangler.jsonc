{
  "name": "melligold-plugin",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": { "enabled": true },
  "vars": {
    "DIDAR_BASE_URL": "https://app.didar.me",
    "DIDAR_CLIENT_ID": "be1652e6d6bfecc3d94514be6a43aca9",
    "MELLIGOLD_API_KEY": "mg_ZhlThctoZ7xAbx9mi_2cn1gw3tmOKJex"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "melligold-plugin-logs",
      "database_id": "8a60912c-93b4-4c2a-984d-4af34bff9045",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LAUNCH", "class_name": "LaunchExchange" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LaunchExchange"] }],
  "services": [
    { "binding": "MELLIGOLD", "service": "melligold-data-source" }
  ]
}
